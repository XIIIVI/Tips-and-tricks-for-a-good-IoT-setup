{
  "apiVersion": "grizzly.grafana.com/v1alpha1",
  "kind": "Datasource",
  "metadata": {
    "name": "ds_prometheus"
  },
  "spec": {
    "name": "prometheus",
    "orgId": 1,
    "type": "prometheus",
    "typeLogoUrl": "public/plugins/prometheus/img/prometheus_logo.svg",
    "uid": "ds_prometheus",
    "url": "https://vmauth:8443/",
    "access": "proxy",
    "isDefault": true,
    "jsonData": {
      "tlsAuth": true,
      "tlsAuthWithCACert": true
    },
    "secureJsonData": {
      "tlsCACert": "${file:/run/secrets/tls_ca_cert}",
      "tlsClientCert": "${file:/run/secrets/tls_client_cert}",
      "tlsClientKey": "${file:/run/secrets/tls_client_key}"
    }
  }
}