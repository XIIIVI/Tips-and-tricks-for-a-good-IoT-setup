            "id": "merge",
            "options": {}
          },
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "includeByName": {},
              "indexByName": {
                "Time": 0,
                "com.docker.stack.namespace": 3,
                "com.docker.swarm.service.name": 4,
                "container_status": 5,
                "docker_container_cpu_usage_percent": 2,
                "docker_container_mem_usage_percent": 6,
                "host": 1
              },
              "renameByName": {
                "com.docker.stack.namespace": "Stack",
                "com.docker.swarm.service.name": "Service",
                "container_status": "Status",
                "docker_container_cpu_usage_percent": "CPU (%)",
                "docker_container_mem_usage_percent": "Memory (%)",
                "host": "Host"
              }
            }
          },
          {
            "id": "groupToNestedTable",
            "options": {
              "fields": {
                "Host": {
                  "aggregations": []
                },
                "Service": {
                  "aggregations": [],
                  "operation": "groupby"
                },
                "Stack": {
                  "aggregations": []
                },
                "com.docker.stack.namespace": {
                  "aggregations": [
                    "last"
                  ],
                  "operation": "aggregate"
                },
                "com.docker.swarm.service.name": {
                  "aggregations": [
                    "last"
                  ]
                },
                "container_status": {
                  "aggregations": [
                    "last"
                  ]
                },
                "docker_container_cpu_usage_percent": {
                  "aggregations": [
                    "allValues"
                  ]
                },
                "docker_container_mem_usage_percent": {
                  "aggregations": [
                    "allValues"
                  ]
                },
                "host": {
                  "aggregations": [],
                  "operation": "groupby"
                }
              },
              "showSubframeHeaders": true
            }
          },
          {
            "id": "sortBy",
            "options": {
              "fields": {},
              "sort": [
                {
                  "field": "Service"
                }
              ]
            }
          }
        ],
        "type": "table"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "ds_prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
