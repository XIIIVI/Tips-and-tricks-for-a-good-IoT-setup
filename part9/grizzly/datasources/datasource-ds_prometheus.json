{
  "apiVersion": "grizzly.grafana.com/v1alpha1",
  "kind": "Datasource",
  "metadata": {
    "name": "ds_prometheus"
  },
  "spec": {
    "access": "proxy",
    "basicAuth": true,
    "basicAuthUser": "$__file{/run/secrets/vmauth_reader.user}",
    "secureJsonData": {
      "basicAuthPassword": "$__file{/run/secrets/vmauth_reader.passwd}"
    },
    "jsonData": {
      "tlsAuthWithCACert": true,
      "tlsCACert": "$__file{/run/secrets/iot.ca}",
      "tlsClientCert": "$__file{/run/secrets/grafana.crt}",
      "tlsClientKey": "$__file{/run/secrets/grafana.key}",
      "httpMethod": "POST",
      "timeInterval": "30s"
    },
    "name": "prometheus",
    "orgId": 1,
    "type": "prometheus",
    "typeLogoUrl": "public/plugins/prometheus/img/prometheus_logo.svg",
    "uid": "ds_prometheus",
    "url": "https://vmauth:8443/"
  }
}