    "preload": false,
    "schemaVersion": 42,
    "tags": [],
    "templating": {
      "list": [
        {
          "allowCustomValue": false,
          "current": {
            "text": [
              "orchestrator1"
            ],
            "value": [
              "orchestrator1"
            ]
          },
          "definition": "label_values(cpu_usage_guest,host)",
          "includeAll": true,
          "label": "Hosts",
          "multi": true,
          "name": "host_list",
          "options": [],
          "query": {
            "qryType": 1,
            "query": "label_values(cpu_usage_guest,host)",
            "refId": "PrometheusVariableQueryEditor-VariableQuery"
          },
          "refresh": 1,
          "regex": "",
          "sort": 5,
          "type": "query"
        },
        {
          "allowCustomValue": false,
          "current": {
            "text": "All",
            "value": [
              "$__all"
            ]
          },
          "definition": "label_values({host=~\"$host_list\"},container_name)",
          "includeAll": true,
          "label": "Services",
          "multi": true,
          "name": "service_list",
          "options": [],
          "query": {
            "qryType": 1,
            "query": "label_values({host=~\"$host_list\"},container_name)",
            "refId": "PrometheusVariableQueryEditor-VariableQuery"
          },
          "refresh": 1,
          "regex": "/(.*)\\..*\\..*/",
          "sort": 5,
          "type": "query"
        }
      ]
    },
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {},
    "timezone": "Europe/Paris",
    "title": "Memory",
    "uid": "dash_memory"
  }
