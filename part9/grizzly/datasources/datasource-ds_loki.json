{
  "apiVersion": "grizzly.grafana.com/v1alpha1",
  "kind": "Datasource",
  "metadata": {
    "name": "ds_loki"
  },
  "spec": {
    "access": "proxy",
    "isDefault": false,
    "jsonData": {
      "tlsAuth": false,
      "tlsAuthWithCACert": true,
      "tlsCACert": "$__file{/run/secrets/iot.ca}",
      "tlsClientCert": "$__file{/run/secrets/grafana.crt}",
      "tlsClientKey": "$__file{/run/secrets/grafana.key}",
      "maxLines": 1000
    },
    "name": "loki",
    "orgId": 1,
    "type": "loki",
    "typeLogoUrl": "public/plugins/loki/img/loki_icon.svg",
    "uid": "ds_loki",
    "url": "https://iot-stack_loki:3100"
  }
}