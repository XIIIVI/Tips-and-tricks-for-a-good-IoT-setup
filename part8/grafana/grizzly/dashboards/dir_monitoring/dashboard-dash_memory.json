          {
            "datasource": {
              "type": "prometheus",
              "uid": "ds_prometheus"
            },
            "editorMode": "builder",
            "expr": "docker_container_mem_usage_percent{host=~\"$host_list\", \"com.docker.swarm.service.name\"=~\"$service_list\"}",
            "legendFormat": "__auto",
            "range": true,
            "refId": "A"
          }
        ],
        "title": "Docker - Memory usage",
        "transformations": [
          {
            "id": "labelsToFields",
            "options": {
              "keepLabels": [
                "__name__",
                "com.docker.stack.namespace",
                "com.docker.swarm.service.name",
                "com.docker.swarm.task.name",
                "container_image",
                "container_name",
                "container_status",
                "host"
              ],
              "valueLabel": "com.docker.swarm.service.name"
            }
          },
          {
            "id": "merge",
            "options": {}
          }
        ],
        "type": "timeseries"
      }
