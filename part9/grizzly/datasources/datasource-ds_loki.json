{
  "apiVersion": "grizzly.grafana.com/v1alpha1",
  "kind": "Datasource",
  "metadata": {
    "name": "ds_loki"
  },
  "spec": {
    "name": "loki",
    "orgId": 1,
    "type": "loki",
    "typeLogoUrl": "public/plugins/loki/img/loki_icon.svg",
    "uid": "ds_loki",
    "url": "https://iot-stack_loki:3100",
    "access": "proxy",
    "isDefault": true,
    "jsonData": {
      "tlsAuth": true,
      "tlsAuthWithCACert": true
    },
    "secureJsonData": {
      "tlsCACert": "${file:/run/secrets/tls_ca_cert}",
      "tlsClientCert": "${file:/run/secrets/tls_client_cert}",
      "tlsClientKey": "${file:/run/secrets/tls_client_key}"
    }
  }
}